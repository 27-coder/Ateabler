# Copy to .env. Blank ATEABLE_ADMIN_KEY means the controller creates a random
# key on first setup and persists it under ATEABLE_DATA_PATH. To supply your
# own, use a long random value; never commit it.
ATEABLE_ADMIN_KEY=

ATEABLE_API_PORT=8765
ATEABLE_BIND_ADDRESS=127.0.0.1
# Set this to the VPN/LAN/HTTPS URL that remote devices should use.
ATEABLE_CONTROLLER_URL=http://localhost:8765
ATEABLE_DATA_PATH=./data
ATEABLE_OUTPUT_PATH=./downloads
ATEABLE_COOKIES_PATH=./cookies
ATEABLE_INPUT_PATH=./inbox

ATEABLE_EMBEDDED_WORKER=false
ATEABLE_LOCAL_CONCURRENCY=1
ATEABLE_WORKER_TIMEOUT_SECONDS=45
ATEABLE_LEASE_SECONDS=120

# Download network policy is configured on each worker.
# The controller never downloads and does not need Tor.
ATEABLE_NETWORK_MODE=direct
ATEABLE_TOR_PROXY=socks5h://tor:9050
# Optional private file with Tor UseBridges/Bridge/ClientTransportPlugin lines.
ATEABLE_TOR_EXTRA_CONFIG=./docker/tor-extra.empty
# Required only when ATEABLE_NETWORK_MODE=proxy.
ATEABLE_PROXY=

# On Linux, set these to `id -u` and `id -g` if your account does not use 1000.
ATEABLE_PUID=1000
ATEABLE_PGID=1000
