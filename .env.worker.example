# Copy to .env.worker on the target machine. Generate a single-use key with
# `ateable device key` on the controller and paste it here for the first start.
# Optional: the pair key carries the URL and the worker persists it on success.
ATEABLE_COORDINATOR_URL=
ATEABLE_PAIR_KEY=
ATEABLE_WORKER_NAME=studio-mac
ATEABLE_WORKER_CONCURRENCY=1

ATEABLE_WORKER_DATA_PATH=./worker-data
ATEABLE_OUTPUT_PATH=./downloads
ATEABLE_COOKIES_PATH=./cookies

# direct, tor, or proxy. Tor is the Compose default.
ATEABLE_NETWORK_MODE=tor
ATEABLE_TOR_PROXY=socks5h://tor:9050
# Optional private file with Tor UseBridges/Bridge/ClientTransportPlugin lines.
ATEABLE_TOR_EXTRA_CONFIG=./docker/tor-extra.empty
# Required only when ATEABLE_NETWORK_MODE=proxy.
ATEABLE_PROXY=
# Optional path inside the worker container, such as /cookies/youtube.txt.
ATEABLE_COOKIES_FILE=

# On Linux, set these to `id -u` and `id -g` if your account does not use 1000.
ATEABLE_PUID=1000
ATEABLE_PGID=1000
