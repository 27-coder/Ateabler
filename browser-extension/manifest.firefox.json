{
  "manifest_version": 3,
  "name": "Ate it on bucket",
  "version": "1.1.0",
  "description": "Save links and media URLs to your local Ateable bucket for later downloads.",
  "permissions": ["contextMenus", "storage", "alarms", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "http://[::1]/*"],
  "background": {"scripts": ["background.js"], "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Ate it on bucket"},
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"},
  "browser_specific_settings": {
    "gecko": {
      "id": "ateable-capture@ateable.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "websiteContent"]}
    }
  }
}
