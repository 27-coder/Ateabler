ClientOnly 1
SocksPort 0.0.0.0:9050
SocksPolicy accept 0.0.0.0/0
SafeSocks 1
TestSocks 1
DataDirectory /var/lib/tor
AvoidDiskWrites 1
SafeLogging 1
Log notice stdout

# Ateable intentionally has no Tor control port. It does not send NEWNYM,
# automate circuit rotation, or attempt to churn exit identities.
#
# This tracked file is empty by default. Operators may mount a private file
# containing UseBridges/Bridge/ClientTransportPlugin directives here.
%include /etc/tor/ateable-extra.conf
